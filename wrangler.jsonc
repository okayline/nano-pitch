{
  // Daily Pitch. The Worker's name must match the one in the Cloudflare dashboard (nano-pitch, on pitch.88x31.app).
  "name": "nano-pitch",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // the page (public/). /api/* goes to the Worker code first.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // the shared accounts (the dungeon-items Worker): save codes and passkeys
  "services": [
    { "binding": "ACCOUNTS", "service": "dungeon-items", "entrypoint": "Accounts" }
  ],
  // Pitch's tables live in the moba-beat database; every one of them is named pitch_...
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moba-beat",
      "database_id": "8ced4f17-0ae0-4852-b02c-5003d7f08c5d"
    }
  ]
}
